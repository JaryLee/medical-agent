POSTGRES_PASSWORD=replace_for_local_use
MINIO_ROOT_USER=replace_for_local_use
MINIO_ROOT_PASSWORD=replace_for_local_use
MINIO_ENABLED=true
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace_for_local_use
MINIO_SECRET_KEY=replace_for_local_use
MINIO_BUCKET=medical-agent-files
FILE_SCAN_MODE=basic
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=5s
AGENT_WORKER_DELAY=500
AGENT_WORKER_INITIAL_DELAY=1000
AGENT_LEASE_DURATION=30s
AGENT_TASK_TIMEOUT=15m
AGENT_SSE_TIMEOUT=30m
MEDICAL_MODEL_MODE=mock
MEDICAL_MODEL_EXTERNAL_ENABLED=false
MEDICAL_MODEL_PROVIDER=deepseek
MEDICAL_MODEL_NAME=deepseek-v4-flash
MEDICAL_MODEL_BASE_URL=https://api.deepseek.com
MEDICAL_MODEL_API_KEY=
MEDICAL_MODEL_API_KEY_FILE=
MEDICAL_MODEL_CONNECT_TIMEOUT=5s
MEDICAL_MODEL_READ_TIMEOUT=60s

# NCBI E-utilities. Set mode=live only after registering tool/email with NCBI.
PUBMED_MODE=mock
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_TOOL=medical_research_agent
PUBMED_EMAIL=
PUBMED_API_KEY=
PUBMED_MAX_RESULTS=20
PUBMED_MAX_ATTEMPTS=3
PUBMED_CONNECT_TIMEOUT=5s
PUBMED_READ_TIMEOUT=30s

# ClinicalTrials.gov API v2; keep mock by default for deterministic local tests.
CLINICAL_TRIALS_MODE=mock
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICAL_TRIALS_USER_AGENT=medical-research-agent/1.0
CLINICAL_TRIALS_MAX_RESULTS=20
CLINICAL_TRIALS_MAX_ATTEMPTS=3
CLINICAL_TRIALS_CACHE_TTL=12h
CLINICAL_TRIALS_CONNECT_TIMEOUT=5s
CLINICAL_TRIALS_READ_TIMEOUT=30s

# Crossref REST API. Blank mailto uses the public pool; set a real contact email
# to identify the client and use the polite pool.
CROSSREF_MODE=mock
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_USER_AGENT=medical-research-agent/1.0
CROSSREF_MAILTO=
CROSSREF_MAX_ATTEMPTS=3
CROSSREF_CACHE_TTL=24h
CROSSREF_CONNECT_TIMEOUT=5s
CROSSREF_READ_TIMEOUT=30s
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/medical_agent
DATABASE_USERNAME=medical_agent
DATABASE_PASSWORD=
SECURE_COOKIE=true
